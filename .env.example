# Werte ohne Anfuehrungszeichen. # und $ in Werten vermeiden.

# --- Broker ---
MQTT_HOST=mosquitto
MQTT_PORT=1883
MQTT_USER=meshbot
MQTT_PASS=hier-eintragen
MQTT_TLS=false

# --- Topics (Vorgabe passt zum meshinfra-Stack) ---
# Kanal: #at-ktn-bot, am Node auf Slot 3
# RX: entschluesselte Kanalnachrichten der Bruecke, <n> ist der Kanalslot am Node
TOPIC_RX=meshinfra/message/channel/3
# TX: Einlieferung ins Rate-Limit-Gate, das daraus send_chan_msg macht
TOPIC_TX=meshinfra/tx/chan
TOPIC_ADMIN=meshinfra/bot/admin
TX_CHANNEL=3

# --- Nutzlast ---
PAYLOAD_FORMAT=json
JSON_PATH_TEXT=payload.text
JSON_PATH_SENDER=payload.sender
JSON_PATH_CHANNEL=payload.channel_idx

# --- Verhalten ---
BOT_ENABLED=true
BOT_NAME=MeshBot
DEFAULT_LOCATION=villach
SOTA_DEFAULT_ASSOC=OE/KT
MAX_MSG_LEN=140
TRANSLITERATE=false

# --- Airtime-Bremsen ---
GLOBAL_LIMIT=12
GLOBAL_WINDOW_S=600
SENDER_LIMIT=4
SENDER_WINDOW_S=300
DEDUP_WINDOW_S=60

# --- !frag: Sprachmodell auf rag-node-01 ---
# Aus per Vorgabe. Einschalten ist eine Entscheidung darueber, was unter dem
# eigenen Rufzeichen gesendet werden darf: die Antwort ist als einzige im Bot
# nicht gemessen, sondern geraten. Sie traegt deshalb das Praefix KI:.
FRAG_ENABLED=false
OLLAMA_URL=http://192.168.1.32:30434/api/chat
FRAG_MODEL=gemma3:4b
FRAG_TIMEOUT_S=20
# Deckel fuer Antwortlaenge und Rechenzeit zugleich.
FRAG_NUM_PREDICT=80
# Strenger als die allgemeinen Bremsen: eine KI-Antwort kostet ein Vielfaches
# einer Wetterabfrage, und die Kiste laeuft nebenbei k3s.
FRAG_SENDER_LIMIT=2
FRAG_SENDER_WINDOW_S=900
FRAG_TAGESLIMIT=100

DOCKER_NETWORK=meshinfra_meshinfra
LOG_LEVEL=INFO
