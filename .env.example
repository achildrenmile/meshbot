# Werte ohne Anfuehrungszeichen. # und $ in Werten vermeiden.

# --- Broker ---
MQTT_HOST=mosquitto
MQTT_PORT=1883
MQTT_USER=meshbot
MQTT_PASS=hier-eintragen
MQTT_TLS=false

# --- Topics (Vorgabe passt zum meshinfra-Stack) ---
# Kanal: #at-ktn-bot, am Node auf Slot 3
# RX: entschluesselte Kanalnachrichten der Bruecke, <n> ist der Kanalslot am Node
TOPIC_RX=meshinfra/message/channel/3
# TX: Einlieferung ins Rate-Limit-Gate, das daraus send_chan_msg macht
TOPIC_TX=meshinfra/tx/chan
TOPIC_ADMIN=meshinfra/bot/admin
TX_CHANNEL=3

# --- Nutzlast ---
PAYLOAD_FORMAT=json
JSON_PATH_TEXT=text
JSON_PATH_SENDER=sender
JSON_PATH_CHANNEL=channel_idx

# --- Verhalten ---
BOT_ENABLED=true
BOT_NAME=MeshBot
DEFAULT_LOCATION=villach
SOTA_DEFAULT_ASSOC=OE/KT
MAX_MSG_LEN=140
TRANSLITERATE=true

# --- Airtime-Bremsen ---
GLOBAL_LIMIT=6
GLOBAL_WINDOW_S=600
SENDER_LIMIT=2
SENDER_WINDOW_S=300
DEDUP_WINDOW_S=60

DOCKER_NETWORK=meshinfra_meshinfra
LOG_LEVEL=INFO
